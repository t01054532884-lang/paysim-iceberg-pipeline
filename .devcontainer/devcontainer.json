{
  "name": "paysim-iceberg-pipeline",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "secrets": {
    "KAGGLE_USERNAME": {
      "description": "Kaggle 사용자 이름 (PaySim 다운로드용)"
    },
    "KAGGLE_KEY": {
      "description": "Kaggle API 키 (kaggle.com > Settings > API)"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && pip install -e .",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
